# ==============================================================================
# ALVOUN Operations Environment Variables Example
# Copy this file to .env or .env.production and provide production credentials
# ==============================================================================

# Database Connection (SQLite local file or LibSQL/Turso URL for production)
DATABASE_URL="file:./dev.db"

# Turso / LibSQL Cloud Database (Optional for distributed edge deployments)
# DATABASE_URL="libsql://your-db-subdomain.turso.io"
# TURSO_AUTH_TOKEN="your-turso-jwt-token"

# NextAuth v5 Secret Key (generate via: openssl rand -base64 32)
AUTH_SECRET="your-32-byte-hex-or-base64-secret-here"

# Canonical URL for production deployment (required in hosted environments like Vercel/Render)
# AUTH_URL="https://operations.alvoun.com"
# NEXTAUTH_URL="https://operations.alvoun.com"

# Automated Session Auto-Closure Cron Shared Secret
# Required for invoking /api/cron/close-sessions via external schedulers (e.g. Vercel Cron, GitHub Actions)
CRON_SECRET="your-cron-secret-token-here"

# Operational Timezone (Default: Asia/Kolkata +05:30)
TZ="Asia/Kolkata"
