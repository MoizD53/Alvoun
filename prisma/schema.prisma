generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums are not supported in SQLite, using String instead.

model Profile {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String    @unique
  password  String
  role      String    @default("SALESMAN")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  salesman  Salesman?
}

model Salesman {
  id           String     @id @default(cuid())
  profileId    String     @unique
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  employeeCode String     @unique
  name         String
  phone        String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  routes       Route[]
  customers    Customer[]
  visits       Visit[]
  sales        Sale[]
  payments     Payment[]
  workSessions WorkSession[]
  locations    Location[]
  assignments  SalesmanAssignment[]
  activityLogs ActivityLog[]
  staffMember  StaffMember?
}

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities    City[]
  customers Customer[]
}

model City {
  id        String   @id @default(cuid())
  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes    Route[]
  customers Customer[]

  @@index([stateId])
}

model Route {
  id         String    @id @default(cuid())
  name       String
  cityId     String
  city       City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  salesmanId String?
  salesman   Salesman? @relation(fields: [salesmanId], references: [id], onDelete: SetNull)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customers  Customer[]
  areas      Area[]
  assignments SalesmanAssignment[]

  @@index([cityId])
  @@index([salesmanId])
}

model Area {
  id        String   @id @default(cuid())
  name      String
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers   Customer[]
  assignments SalesmanAssignment[]

  @@unique([name, routeId])
  @@index([routeId])
}

model SalesmanAssignment {
  id         String   @id @default(cuid())
  salesmanId String
  routeId    String
  areaId     String
  salesman   Salesman @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([salesmanId, areaId])
  @@index([salesmanId])
  @@index([routeId])
  @@index([areaId])
}

model Customer {
  id                 String      @id @default(cuid())
  customerName       String
  contact            String
  address            String
  stateId            String
  state              State       @relation(fields: [stateId], references: [id], onDelete: Restrict)
  cityId             String
  city               City        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  routeId            String?
  route              Route?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  areaId             String?
  area               Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  salesmanId         String?
  salesman           Salesman?   @relation(fields: [salesmanId], references: [id], onDelete: SetNull)
  openingBalance     Int         @default(0)
  openingBalanceType String      @default("DEBIT")
  category           String      @default("RETAILER") // RETAILER, DEALER, DISTRIBUTOR
  firmName           String?
  code               String?
  status             String      @default("ACTIVE")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  visits             Visit[]
  sales              Sale[]
  payments           Payment[]
  customerRates      CustomerProductRate[]
  auditLogs          AuditLog[]

  @@index([stateId])
  @@index([cityId])
  @@index([routeId])
  @@index([areaId])
  @@index([salesmanId])
  @@index([status])
}

model Product {
  id              String     @id @default(cuid())
  name            String     @unique
  bottlesPerCrate Int
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  rates             Rate[]
  saleItems         SaleItem[]
  productionBatches ProductionBatch[]
  customerRates     CustomerProductRate[]
  auditLogs         AuditLog[]
}

model Rate {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity   Int       @default(0)
  maxQuantity   Int?
  rate          Int
  effectiveDate DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId])
}

model Visit {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesmanId   String
  salesman     Salesman  @relation(fields: [salesmanId], references: [id], onDelete: Restrict)
  startedAt    DateTime  @default(now())
  status       String    @default("STARTED") // STARTED, COMPLETED
  noSaleReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([customerId])
  @@index([salesmanId])
  @@index([createdAt])
  @@index([status])
}

model Sale {
  id          String     @id @default(cuid())
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesmanId  String
  salesman    Salesman   @relation(fields: [salesmanId], references: [id], onDelete: Restrict)
  saleDate    DateTime   @default(now())
  totalAmount Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items       SaleItem[]

  @@index([customerId])
  @@index([salesmanId])
  @@index([saleDate])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  crates       Int
  looseBottles Int      @default(0)
  standardRate Int
  actualRate   Int
  amount       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesmanId      String
  salesman        Salesman @relation(fields: [salesmanId], references: [id], onDelete: Restrict)
  amount          Int
  paymentMethod   String   // Cash, UPI, Bank Transfer, Cheque, Other
  referenceNumber String?
  paymentDate     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([salesmanId])
  @@index([paymentDate])
}

model WorkSession {
  id         String    @id @default(cuid())
  salesmanId String
  salesman   Salesman  @relation(fields: [salesmanId], references: [id], onDelete: Restrict)
  workDate   DateTime
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  status     String    @default("ACTIVE") // ACTIVE, COMPLETED, FORCE_CLOSED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  locations  Location[]

  @@unique([salesmanId, workDate])
  @@index([salesmanId])
  @@index([workDate])
}

model Location {
  id            String      @id @default(cuid())
  salesmanId    String
  workSessionId String
  latitude      Float
  longitude     Float
  accuracy      Float
  recordedAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())

  salesman      Salesman    @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  @@index([salesmanId, recordedAt])
  @@index([workSessionId, recordedAt])
  @@index([recordedAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  salesmanId  String
  salesman    Salesman @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  type        String   // e.g., 'VISIT_START', 'VISIT_END', 'SALE', 'PAYMENT', 'ONLINE'
  description String
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  @@index([salesmanId])
  @@index([createdAt])
}

model Expense {
  id            String   @id @default(cuid())
  category      String   // SALARY, FUEL, TRANSPORTATION, VEHICLE_MAINTENANCE, LABOUR, ELECTRICITY, MISCELLANEOUS
  title         String
  amount        Int      // stored in Paise
  expenseDate   DateTime @default(now())
  paymentMethod String   @default("CASH") // CASH, BANK_TRANSFER, UPI, CHEQUE
  recipient     String?
  referenceNo   String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([expenseDate])
}

model ProductionBatch {
  id             String   @id @default(cuid())
  batchNumber    String   @unique
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  cratesProduced Int
  looseBottles   Int      @default(0)
  totalBottles   Int
  volumeLitres   Float
  productionDate DateTime @default(now())
  shift          String   @default("DAY") // DAY, NIGHT
  supervisor     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@index([productionDate])
}

model RawMaterial {
  id              String   @id @default(cuid())
  name            String   @unique // e.g. "Preform (1 Litre)", "Stickers (500ml)", "Cap", "Shrink Roll", "Ink/Make-up/Cleaner"
  category        String   // PREFORM, STICKER, CAP, SHRINK_ROLL, INK_CHEMICAL
  unit            String   // KG, BAG, PCS, BOX, NOS, BOTTLE
  currentStock    Float    @default(0)
  minReorderLevel Float    @default(0)
  targetProduct   String?  // 1 Litre, 500ml, 250ml, 2 Litre, or ALL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements       RawMaterialMovement[]
}

model RawMaterialMovement {
  id           String      @id @default(cuid())
  materialId   String
  material     RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type         String      // INWARD, CONSUMED, ADJUSTMENT
  quantity     Float
  openingStock Float
  closingStock Float
  referenceNo  String?
  movementDate DateTime    @default(now())
  notes        String?
  createdAt    DateTime    @default(now())

  @@index([materialId])
  @@index([movementDate])
  @@index([type])
}

model StaffMember {
  id            String   @id @default(cuid())
  employeeCode  String   @unique // e.g. EMP-001
  name          String
  role          String   // PRODUCTION_STAFF, ACCOUNTANT, DRIVER, LABOUR, SUPERVISOR, SALESMAN
  designation   String?  // e.g. "Sales Representative", "Technical Manager", "Salesman", "Operator", "Associate", "Employee"
  phone         String?
  monthlySalary Int      // stored in Paise
  joinDate      DateTime @default(now())
  isActive      Boolean  @default(true)
  salesmanId    String?  @unique
  salesman      Salesman? @relation(fields: [salesmanId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendances   StaffAttendance[]
  payrolls      PayrollRecord[]
  payments      SalaryPayment[]
}

model StaffAttendance {
  id        String      @id @default(cuid())
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime    @default(now())
  dateStr   String?     // YYYY-MM-DD
  status    String      @default("PRESENT") // PRESENT, ABSENT, HALF_DAY
  checkIn   DateTime?
  checkOut  DateTime?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
  @@index([dateStr])
}

model PayrollRecord {
  id                  String          @id @default(cuid())
  staffId             String
  staff               StaffMember     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month               Int             // 1 - 12
  year                Int             // e.g. 2026
  basicSalary         Int             // in Paise
  allowances          Int             @default(0) // in Paise
  deductions          Int             @default(0) // in Paise
  advances            Int             @default(0) // in Paise
  fullDayAbsences     Int             @default(0)
  halfDayAbsences     Int             @default(0)
  fullDayDeductions   Int             @default(0) // in Paise
  halfDayDeductions   Int             @default(0) // in Paise
  netPayable          Int             // in Paise
  paidAmount          Int             @default(0) // in Paise
  remainingBalance    Int             @default(0) // in Paise
  status              String          @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  paymentDate         DateTime?
  paymentMethod       String?         // CASH, BANK_TRANSFER, UPI, CHEQUE
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  payments            SalaryPayment[]

  @@unique([staffId, month, year])
  @@index([staffId])
  @@index([year, month])
}

model SalaryPayment {
  id              String        @id @default(cuid())
  payrollRecordId String
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  staffId         String
  staff           StaffMember   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount          Int           // in Paise
  paymentDate     DateTime      @default(now())
  paymentMethod   String        // CASH, BANK_TRANSFER, UPI, CHEQUE
  referenceNo     String?
  notes           String?
  recordedBy      String?
  isReversed      Boolean       @default(false)
  reversalReason  String?
  reversedAt      DateTime?
  reversedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([payrollRecordId])
  @@index([staffId])
  @@index([paymentDate])
}


model CustomerProductRate {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rate       Int      // Stored in Paise per crate
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorId      String
  actorName    String
  actorRole    String
  action       String    // 'CUSTOMER_RATE_UPDATED', 'CUSTOMER_RATE_RESET'
  entityType   String    // 'CustomerProductRate'
  entityId     String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  previousRate Int?      // in Paise
  newRate      Int?      // in Paise
  details      String?
  createdAt    DateTime  @default(now())

  @@index([customerId])
  @@index([productId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
